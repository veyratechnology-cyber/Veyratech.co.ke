# VeyraTech Environment Variables
# Production: https://veyratech.co.ke

# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/database

# Authentication
NEXTAUTH_URL=https://veyratech.co.ke
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=your-secret-key-here

# Public URLs
NEXT_PUBLIC_APP_URL=https://veyratech.co.ke
NEXT_PUBLIC_ADMIN_URL=https://veyratech.co.ke/admin

# Environment
NODE_ENV=production
TZ=Africa/Nairobi

# Cron Job Security
CRON_SECRET=your-cron-secret-here

# Email Configuration (Optional)
RESEND_API_KEY=
EMAIL_FROM=VeyraTech <noreply@veyratech.com>
ADMIN_EMAIL=admin@veyratech.com

# Admin Contacts
ADMIN_PHONE_NUMBER=+254745247211
ADMIN_WHATSAPP_NUMBER=+254745247211

# M-Pesa Configuration (Daraja API)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-passkey
# Random secret appended to the M-Pesa callback URL so forged payment callbacks
# are rejected. Generate like NEXTAUTH_SECRET. If unset, success callbacks are
# confirmed with Safaricom's STK query API instead.
MPESA_CALLBACK_SECRET=

# Set to "true" only temporarily when you need /api/admin/seed-database
# (it DELETES and re-inserts services and industries).
ALLOW_DB_SEED=false

# Used by `npm run db:seed` / scripts/create-admin.* (never commit real values)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
