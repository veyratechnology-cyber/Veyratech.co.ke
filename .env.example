# VeyraTech Environment Variables
# Production: https://veyratech.co.ke

# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/database

# Authentication
NEXTAUTH_URL=https://veyratech.co.ke
NEXTAUTH_SECRET=your-secret-key-here

# Public URLs
NEXT_PUBLIC_APP_URL=https://veyratech.co.ke
NEXT_PUBLIC_ADMIN_URL=https://veyratech.co.ke/admin

# Environment
NODE_ENV=production
TZ=Africa/Nairobi

# Cron Job Security
CRON_SECRET=your-cron-secret-here

# Email Configuration (Optional)
RESEND_API_KEY=
EMAIL_FROM=VeyraTech <noreply@veyratech.com>
ADMIN_EMAIL=admin@veyratech.com

# Admin Contacts
ADMIN_PHONE_NUMBER=+254745247211
ADMIN_WHATSAPP_NUMBER=+254745247211

# M-Pesa Configuration (Daraja API)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-passkey
